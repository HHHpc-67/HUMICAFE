<!DOCTYPE html>
@using HuniCafe.Models
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - HuniCafe</title>
    <link href="~/Content/bootstrap.css" rel="stylesheet" /> 
    <link href="~/Content/Style_Cafe/layout.css" rel="stylesheet" />
    <link href="~/Content/Style_Cafe/Banner.css" rel="stylesheet" />
    <link href="~/Content/Style_Cafe/product.css" rel="stylesheet" />
    <link href="~/Content/Style_Cafe/cart.css" rel="stylesheet" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

    <header>
        <nav class="navbar">
            <div class="logo">
                <a href="@Url.Action("MainPage", "Home")">HUNI <span>CAFE</span></a>
            </div>

            <ul class="nav-links">
                <li><a href="@Url.Action("MainPage", "Home")">Home</a></li>
                <li><a href="@Url.Action("Index", "Product")">Menu</a></li>

                @{
                    var cart = Session["Cart"] as List<Cart>;
                    int cartCount = 0;

                    if (cart != null)
                    {
                        cartCount = cart.Sum(x => x.Quantity);
                    }
                }
                <li>
                    <a href="@Url.Action("Index", "Cart")">
                        Giỏ Hàng
                        @if (cartCount > 0)
                        {
                            <span class="cart-badge">@cartCount</span>
                        }
                    </a>
                </li>

                <li><a href="@Url.Action("MyOrders", "Order")">Đơn Hàng</a></li>
            </ul>

            <div class="account">
                @if (Session["UserID"] != null)
                {
                    <div class="user-profile-box">
                        <!-- Click vào Ảnh Profile sẽ nhảy đến Trang Cá Nhân -->
                        <a href="@Url.Action("CustomerProfile", "Customer")" title="Trang cá nhân">
                            <img src="~/Content/Images/Users_profile.png" alt="Profile Picture" class="user-avatar-img" />
                        </a>

                        <div class="user-info-text">
                            <span class="user-greeting">
                                <svg class="small-profile-icon" viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
                                </svg>
                                <!-- Click vào Tên cũng nhảy đến Trang Cá Nhân -->
                                <a href="@Url.Action("CustomerProfile", "Customer")" style="text-decoration: none; color: inherit;">
                                    Xin chào, <strong>@(Session["FullName"] ?? "Khách")</strong>
                                </a>

                                @if (Session["Role"]?.ToString() == "Admin")
                                {
                                    <span class="role-badge role-admin">(Admin)</span>
                                }
                            </span>

                            <div class="user-links">
                                @if (Session["Role"]?.ToString() == "Admin")
                                {
                                    <a href="@Url.Action("Admin", "Users")" class="link-admin-page">[Trang Quản Trị]</a>
                                }
                                <a href="@Url.Action("Logout", "Users")" class="link-logout">(Đăng xuất)</a>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <a href="@Url.Action("Login", "Users")">Login</a>
                    <span class="divider">|</span>
                    <a href="@Url.Action("Register", "Users")">Register</a>
                }
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer>
        <p>&copy; @DateTime.Now.Year - HUNICAFE. All rights reserved.</p>
    </footer>
</body>
</html>