@model HuniCafe.Models.Product

<a href="@Url.Action("Details", "Home", new { id = Model.ProductID })" class="product-card-link" style="text-decoration: none; color: inherit;">
    <div class="product-card">
        <div class="product-image">
            <img src="@Model.Image" alt="@Model.ProductName" />
        </div>

        <div class="product-info">
            <h3>@Model.ProductName</h3>

            <p class="price">
                @String.Format("{0:N0} VNĐ", Model.Price)
            </p>
        </div>
    </div>
</a>