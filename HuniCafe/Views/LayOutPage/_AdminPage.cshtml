@{
    Layout = null; 
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - HuniCafe Admin</title>
    <!-- Bootstrap CSS  -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- CSS -->
    <link href="@Url.Content("~/Content/Admin/AdminStyle.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/Admin/CategoryProduct.css")" rel="stylesheet" />
</head>
<body>

    <div class="admin-sidebar">
        <div class="admin-brand">
            HUNI <span>ADMIN</span>
        </div>
        <ul class="admin-menu">
            <li><a href="@Url.Action("Admin", "Users")">Dashboard</a></li>
            <li><a href="@Url.Action("CategoryPage", "Category")">Quản lý Danh mục</a></li>
            <li><a href="@Url.Action("Product_Admin", "Product")">Quản lý Sản phẩm</a></li>
            <li><a href="@Url.Action("AdminOrders", "Order")">Quản lý Đơn hàng</a></li>
            <li><a href="@Url.Action("Coupon", "Coupon")" target="_self">Quản lý ưu đãi</a></li>
            <li><a href="@Url.Action("MainPage", "Home")" target="_self">Xem Trang chủ Web</a></li>
            <li><a href="@Url.Action("Logout", "Users")">Đăng xuất</a></li>
        </ul>
    </div>

    <div class="admin-main">
        <div class="admin-header">
            <h2>@ViewBag.Title</h2>
            <div>Xin chào, <strong>Admin</strong></div>
        </div>

        <div class="admin-card">
            @RenderBody()
        </div>
    </div>

</body>
</html>