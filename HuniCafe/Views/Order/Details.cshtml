@model HuniCafe.Models.Order
@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Views/LayOutPage/_LayoutMainPage.cshtml";
}

<div class="container my-4">
    <h2>Chi tiết đơn hàng #@Model.OrderID</h2>

    <p><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
    <p>
        <strong>Trạng thái:</strong>
        <td>
            @switch (Model.Status)
            {
                case "Pending":
                    <span class="badge bg-warning text-dark">Chờ xử lý</span>
                    break;

                case "Confirmed":
                    <span class="badge bg-info text-dark">Đã xác nhận</span>
                    break;

                case "Shipping":
                    <span class="badge bg-primary">Đang giao tới</span>
                    break;

                case "Completed":
                    <span class="badge bg-success">Hoàn thành</span>
                    break;

                case "Cancelled":
                    <span class="badge bg-danger">Đã hủy</span>
                    break;

                default:
                    <span class="badge bg-secondary">@Model.Status</span>
                    break;
            }
        </td>
    </p>

    <hr />

    <table class="table table-bordered align-middle">
        <thead>
            <tr>
                <th>Sản phẩm</th>
                <th>Hình ảnh</th>
                <th>Đơn giá</th>
                <th>Số lượng</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.OrderDetails)
            {
                <tr>
                    <td>@item.Product.ProductName</td>
                    <td>
                        <img src="@item.Product.Image" alt="@item.Product.ProductName" style="width: 60px; height: 60px; object-fit: cover;" class="rounded" />
                    </td>
                    <td>@String.Format("{0:N0} VNĐ", item.Price)</td>
                    <td>@item.Quantity</td>
                    <td>@String.Format("{0:N0} VNĐ", item.Price * item.Quantity)</td>
                </tr>
            }
        </tbody>
    </table>

    <h3 class="text-end text-danger mt-3">
        Tổng: @String.Format("{0:N0} VNĐ", Model.TotalAmount)
    </h3>

    <div class="mt-3">
        <a href="@Url.Action("MyOrders", "Order")" class="btn btn-secondary">Quay lại danh sách đơn hàng</a>
    </div>
</div>