@model IEnumerable<HuniCafe.Models.Product>

@{
    ViewBag.Title = "Quản Lý Sản phẩm";
    Layout = "~/Views/LayOutPage/_AdminPage.cshtml";
}
<link href="~/Content/Admin/ProductCategory.css" rel="stylesheet" />
<div class="admin-product-container">
    <div class="admin-actions">
        @Html.ActionLink("Thêm sản phẩm", "Create", null, new { @class = "btn-add-product" })
    </div>

    <table class="admin-product-table">
        <thead>
            <tr>
                <th>Tên Sản phẩm</th>
                <th>Mô tả</th>
                <th>Đơn giá</th>
                <th>Hình</th>
                <th>Loại Sản phẩm</th>
                <th class="text-center">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="product-name">
                        @Html.DisplayFor(modelItem => item.ProductName)
                    </td>
                    <td class="product-desc">
                        @Html.DisplayFor(modelItem => item.Description)
                    </td>
                    <td class="product-price">
                        @(item.Price > 0 ? item.Price.ToString("N0") + " VNĐ" : "0 VNĐ")
                    </td>
                    <td class="product-img-cell">
                        @if (!string.IsNullOrEmpty(item.Image))
                        {
                            <img src="@item.Image" alt="@item.ProductName" class="product-thumb" />
                        }
                        else
                        {
                            <span class="no-img">Chưa có ảnh</span>
                        }
                    </td>
                    <td class="product-category">
                        @(item.Category != null ? item.Category.CategoryName : "Loại " + item.CategoryID) (ID: @item.CategoryID)
                    </td>
                    <td class="product-actions text-center">
                        @Html.ActionLink("Cập nhật", "Edit", new { id = item.ProductID }, new { @class = "btn-action btn-edit" })
                        @Html.ActionLink("Chi tiết", "Details", new { id = item.ProductID }, new { @class = "btn-action btn-details" })
                        @Html.ActionLink("Xóa", "Delete", new { id = item.ProductID }, new { @class = "btn-action btn-delete" })
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
