@model HuniCafe.Models.Product

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/LayOutPage/_AdminPage.cshtml";
}
<link href="~/Content/Admin/EditProduct.css" rel="stylesheet" />
<div class="admin-edit-container">
    <h2 class="admin-page-title">Cập nhật sản phẩm</h2>

    @using (Html.BeginForm("Edit", "Product", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="form-horizontal">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.ProductID)

            <div class="form-group-row">
                <label class="form-label">Tên Sản Phẩm</label>
                <div class="form-input">
                    @Html.EditorFor(model => model.ProductName, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.ProductName, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group-row">
                <label class="form-label">Mô tả</label>
                <div class="form-input">
                    @Html.EditorFor(model => model.Description, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group-row">
                <label class="form-label">Loại SP</label>
                <div class="form-input">
                    @Html.DropDownList("CategoryID", null, htmlAttributes: new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.CategoryID, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group-row">
                <label class="form-label">Đơn giá</label>
                <div class="form-input">
                    @Html.EditorFor(model => model.Price, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Price, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group-row">
                <label class="form-label">Hình(Gắn Link Cloudary)</label>
                <div class="form-input">
                    @Html.EditorFor(model => model.Image, new { htmlAttributes = new { @class = "form-control", placeholder = "https://res.cloudinary.com/..." } })
                    @Html.ValidationMessageFor(model => model.Image, "", new { @class = "text-danger" })
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Image))
            {
                <div class="form-group-row">
                    <label class="form-label">Xem trước ảnh</label>
                    <div class="form-input">
                        <img src="@Model.Image" alt="@Model.ProductName" class="preview-img" />
                    </div>
                </div>
            }

            <div class="form-group-row btn-group-row">
                <div class="form-input-offset">
                    <input type="submit" value="Cập nhật" class="btn-submit" />
                    @Html.ActionLink("Quay lại", "Product_Admin", null, new { @class = "btn-back" })
                </div>
            </div>
        </div>
    }
</div>
