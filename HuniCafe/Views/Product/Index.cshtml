@model HuniCafe.Models.ViewModel.ProductViewModel

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/LayOutPage/_LayoutMainPage.cshtml";
}

<div class="container">

    <h2>Tất cả sản phẩm</h2>

     
        <div class="product-list">
            @foreach (var product in Model.Products)
            {
                @Html.Partial("~/Views/LayOutPage/_ProductCard.cshtml", product)
            }
        </div>
  
</div>
