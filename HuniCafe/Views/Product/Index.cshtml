@model HuniCafe.Models.ViewModel.ProductViewModel

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/LayOutPage/_LayoutMainPage.cshtml";
}

<div class="container">

    <section class="product-page">

        <div class="product-header">
            <h1>Menu</h1>
            <p>Hãy chọn thức uống của bạn</p>
        </div>

        <div class="category-filter">

            <a href="@Url.Action("Index", "Product")"
               class="category-filter-btn @(Model.SelectedCategory == null ? "active" : "")">
                Tất cả
            </a>

            @foreach (var category in Model.Categories)
            {
                <a href="@Url.Action("Index", "Product", new { categoryId = category.CategoryID })"
                   class="category-filter-btn @(Model.SelectedCategory == category.CategoryID ? "active" : "")">

                    @category.CategoryName

                </a>
            }

        </div>

        <div class="search-container">

            @using (Html.BeginForm("Index", "Product", FormMethod.Get))
            {
                <input type="text" name="keyword" placeholder="Tìm kiếm sản phẩm..." value="@ViewBag.Keyword" class="search-input" />

                @* Giữ lại category *@
                if (ViewBag.CategoryId != null)
                {
                    <input type="hidden"
                           name="categoryId"
                           value="@ViewBag.CategoryId" />
                }

                <button type="submit" class="search-btn">
                    Tìm kiếm
                </button>
            }

        </div>


        @if (!Model.Products.Any())
        {
            <div class="empty-product">
                Không tìm thấy sản phẩm phù hợp.
            </div>
        }
        else
        {

            <div class="product-list">

                @foreach (var product in Model.Products)
                {

                    @Html.Partial("~/Views/LayOutPage/_ProductCard.cshtml", product)
                }

            </div>
        }
    </section>

</div>
