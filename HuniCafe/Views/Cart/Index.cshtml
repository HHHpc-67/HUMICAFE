@model IEnumerable<HuniCafe.Models.Cart>

@{
    ViewBag.Title = "Shopping Cart";
    Layout = "~/Views/LayOutPage/_LayoutMainPage.cshtml";
}

<div class="container">

    <div class="cart-header">
        <h2>Shopping Cart</h2>

        <p>
            @Model.Sum(x => x.Quantity) sản phẩm
        </p>
    </div>


    @if (Model.Count() == 0)
    {
        <div class="empty-cart">

            <h3>Giỏ hàng đang trống</h3>

            <p>Hãy chọn những sản phẩm yêu thích của bạn.</p>

            <a href="@Url.Action("Index", "Product")"
               class="continue-shopping">
                Tiếp tục mua hàng
            </a>

        </div>
    }
    else
    {
        <div class="cart-content" style="">

            <div class="cart-items">

                @foreach (var item in Model)
                {
                    <div class="cart-item">

                        <div class="cart-product">

                            <img src="@item.Image"
                                 alt="@item.ProductName" />

                            <div>
                                <h3>@item.ProductName</h3>

                                <p>
                                    @String.Format("{0:N0} VNĐ", item.Price)
                                </p>
                            </div>

                        </div>


                        <div class="cart-quantity">

                            <a href="@Url.Action("Decrease", "Cart", new { id = item.ProductID })"
                               class="quantity-btn">
                                -
                            </a>

                            <span>@item.Quantity</span>

                            <a href="@Url.Action("Increase", "Cart", new { id = item.ProductID })"
                               class="quantity-btn">
                                +
                            </a>


                        </div>


                        <div class="cart-total">

                            <strong>
                                @String.Format("{0:N0} VNĐ", item.Total)
                            </strong>

                        </div>


                        <div class="cart-remove">

                            <a href="@Url.Action("Remove","Cart", new {id = item.ProductID})" class="remove-btn">
                                x
                            </a>

                        </div>

                    </div>
                }

            </div>


            <div class="cart-summary">

                <h3>Order Summary</h3>

                <div class="summary-row">

                    <span>Tạm tính</span>

                    <strong>
                        @String.Format("{0:N0} VNĐ", Model.Sum(x => x.Total))
                    </strong>

                </div>

                <div class="summary-row">

                    <span>Phí giao hàng</span>

                    <strong>0 VNĐ</strong>

                </div>

                @* --- BỔ SUNG: Khung nhập Mã Giảm Giá --- *@
                <div class="coupon-section my-3" style="margin: 15px 0;">
                    <div class="input-group" style="display: flex; gap: 5px;">
                        <input type="text" id="couponCodeInput" class="form-control" placeholder="Nhập mã giảm giá..." value="@Session["CouponCode"]" style="flex: 1; padding: 8px; border: 1px solid #ccc; border-radius: 4px;" />
                        <button type="button" id="btnApplyCoupon" onclick="applyCoupon()" class="btn btn-dark" style="padding: 8px 15px; background: #333; color: #fff; border: none; border-radius: 4px; cursor: pointer;">Áp dụng</button>
                    </div>
                    <small id="couponMessage" style="display: block; margin-top: 5px; font-size: 13px;"></small>
                </div>

                @* --- BỔ SUNG: Hiển thị tiền giảm giá nếu đã áp dụng thành công --- *@
                @{
                    decimal subTotal = Model.Sum(x => x.Total);
                    decimal discountAmount = Session["DiscountAmount"] != null ? Convert.ToDecimal(Session["DiscountAmount"]) : 0m;
                    decimal finalTotal = subTotal - discountAmount;
                    if (finalTotal < 0) { finalTotal = 0; }
                }

                @if (discountAmount > 0)
                {
                    <div class="summary-row text-success" style="color: #28a745;">
                        <span>Mã giảm giá (@Session["CouponCode"])</span>
                        <strong>-@String.Format("{0:N0} VNĐ", discountAmount)</strong>
                    </div>
                }

                <hr />

                <div class="summary-total">

                    <span>Tổng cộng</span>

                    <strong>
                        @String.Format("{0:N0} VNĐ", finalTotal)
                    </strong>

                </div>

                <a href="@Url.Action("Checkout","Cart")"
                   class="checkout-btn">
                    Đặt hàng
                </a>

            </div>

        </div>
    }

</div>

@* ---Script xử lý AJAX Áp dụng Mã Giảm Giá --- *@
@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        function applyCoupon() {
            var code = $('#couponCodeInput').val().trim();
            var $msg = $('#couponMessage');

            $msg.removeClass('text-success text-danger').css('color', '');

            $.ajax({
                url: '@Url.Action("ApplyCoupon", "Cart")',
                type: 'POST',
                data: { couponCode: code },
                success: function (res) {
                    if (res.success) {
                        $msg.css('color', 'green').text(res.message);
                        setTimeout(function () {
                            location.reload();
                        }, 500);
                    } else {
                        $msg.css('color', 'red').text(res.message);
                    }
                },
                error: function () {
                    $msg.css('color', 'red').text('Có lỗi xảy ra, vui lòng thử lại sau.');
                }
            });
        }
    </script>
}