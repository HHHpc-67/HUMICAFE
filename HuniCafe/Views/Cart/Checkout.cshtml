@model HuniCafe.Models.ViewModel.CheckoutViewModel

@{
    ViewBag.Title = "Checkout";
    Layout = "~/Views/LayOutPage/_LayoutMainPage.cshtml";

    // 📌 Lấy số tiền giảm từ Session
    decimal discountAmount = Session["DiscountAmount"] != null ? Convert.ToDecimal(Session["DiscountAmount"]) : 0m;
    decimal subTotal = Model.TotalAmount;
    decimal finalTotal = subTotal - discountAmount;
    if (finalTotal < 0) { finalTotal = 0; }
}
<link href="~/Content/bootstrap-grid.css" rel="stylesheet" />
<div class="container">

    @using (Html.BeginForm("Checkout", "Cart", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="checkout-container">

            <div class="checkout-left">

                <h2>Thông tin giao hàng</h2>

                <div class="form-group">
                    <label>Họ và tên</label>
                    @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label>Email</label>
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @readonly = "readonly" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label>Số điện thoại</label>
                    @Html.TextBoxFor(m => m.Phone, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label>Địa chỉ giao hàng</label>
                    @Html.TextAreaFor(m => m.Address, new
               {
                   @class = "form-control",
                   rows = "3",

               }) @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger" })

        </div>

        <div class="form-group">
            <label>Ghi chú</label>
            @Html.TextAreaFor(m => m.Note, new
       {
           @class = "form-control",
           rows = "3"
       })
        </div>

    </div>

    <div class="checkout-right">

        <h2>Đơn hàng của bạn</h2>

        <table class="table">
            <tr>
                <th>Sản phẩm</th>
                <th>SL</th>
                <th>Thành tiền</th>
            </tr>

            @foreach (var item in Model.Cart)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td>@item.Quantity</td>
                    <td>@String.Format("{0:N0} VNĐ", item.Total)</td>
                </tr>
            }
        </table>

        @* Hiển thị giảm giá nếu có áp mã *@
        @if (discountAmount > 0)
        {
            <div style="display: flex; justify-content: space-between; margin-top: 15px; font-weight: 500; color: #28a745;">
                <span>Tạm tính:</span>
                <span>@String.Format("{0:N0} VNĐ", subTotal)</span>
            </div>
            <div style="display: flex; justify-content: space-between; margin-top: 5px; font-weight: 500; color: #28a745;">
                <span>Giảm giá (@Session["CouponCode"]):</span>
                <span>-@String.Format("{0:N0} VNĐ", discountAmount)</span>
            </div>
            <hr />
        }

        <h3>
            Tổng tiền:
            @String.Format("{0:N0} VNĐ", finalTotal)
        </h3>

        <button type="submit" class="checkout-btn">
            Xác nhận đặt hàng
        </button>

    </div>

</div>
}
</div>