@model IEnumerable<HuniCafe.Models.Category> 

@{
    ViewBag.Title = "CategoryPage";
    Layout = "~/Views/LayOutPage/_AdminPage.cshtml";
}


<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Quản lý danh mục sản phẩm</h2>
        <a href="@Url.Action("Create", "Category")" class="btn btn-primary">
            + Thêm danh mục mới
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <table class="table table-bordered table-hover">
        <thead class="thead-dark">
            <tr>
                <th>ID</th>
                <th>Tên danh mục</th>
                <th>Mô tả</th>
                <th>Số sản phẩm</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.CategoryID</td>
                    <td><strong>@item.CategoryName</strong></td>
                    <td>@item.CategoryDescription</td>
                    <td>
                        <span class="badge bg-info text-dark">
                            @(item.Products != null ? item.Products.Count : 0) món
                        </span>
                    </td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge bg-success">Hiển thị</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Đã ẩn</span>
                        }
                    </td>
                    <td>
                        <a href="@Url.Action("Edit", "Category", new { id = item.CategoryID })" class="btn btn-sm btn-warning">Sửa</a>

                        <a href="@Url.Action("ToggleStatus", "Category", new { id = item.CategoryID })" class="btn btn-sm btn-info">
                            @(item.IsActive ? "Ẩn" : "Hiện")
                        </a>

                        <a href="@Url.Action("Delete", "Category", new { id = item.CategoryID })" class="btn btn-sm btn-danger">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

