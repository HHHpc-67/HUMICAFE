@model HuniCafe.Models.Category

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/LayOutPage/_AdminPage.cshtml";
}
<div class="category-card-container">
    <div class="category-card-header">
        <h3>Chỉnh sửa danh mục</h3>
        <p>Cập nhật thông tin danh mục #@Model.CategoryID</p>
    </div>

    <div class="category-card-body">
        @using (Html.BeginForm("Edit", "Category", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.CategoryID)

            <div class="form-group-custom">
                @Html.LabelFor(model => model.CategoryName)
                @Html.TextBoxFor(model => model.CategoryName, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.CategoryName, "", new { @class = "text-danger" })
            </div>

            <div class="form-group-custom">
                @Html.LabelFor(model => model.CategoryDescription)
                @Html.TextAreaFor(model => model.CategoryDescription, new { @class = "form-control", @rows = 3 })
                @Html.ValidationMessageFor(model => model.CategoryDescription, "", new { @class = "text-danger" })
            </div>

            <div class="form-group-custom">
                <div class="custom-switch-box">
                    @Html.CheckBoxFor(model => model.IsActive, new { @id = "IsActiveCheck", @style = "width: 18px; height: 18px; cursor: pointer;" })
                    <label for="IsActiveCheck">Trạng thái hiển thị danh mục</label>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-4">
                <a href="@Url.Action("CategoryPage", "Category")" class="btn-custom-back">← Hủy bỏ</a>
                <button type="submit" class="btn-custom-submit">Lưu thay đổi</button>
            </div>
        }
    </div>
</div><h2>Edit</h2>

