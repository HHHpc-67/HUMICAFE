@{
    ViewBag.Title = "Trang Chủ";
    Layout = "~/Views/LayOutPage/_LayoutMainPage.cshtml";
}

@model HuniCafe.Models.ViewModel.HomeViewModel
<section class="huni-hero">
    <div class="hero-content">
        <h1>Welcome to <span>HUNI CAFE</span></h1>
        <p>
            Cà phê thơm, bánh ngọt ngon và những khoảnh khắc khó quên.
        </p>
        <a href="@Url.Action("Index", "Product")" class="btn-huni-order">
            Đặt Hàng Ngay
        </a>
    </div>
</section>


<div class="container">

    @*=========================danh muc mon*@


    <section class="huni-cate">
        <h2>Danh mục món</h2>
        <div class="huni-category-list">
            @foreach (var item in Model.Categories)
            {
                <div class="huni-category-card">
                    <h3>@item.CategoryName</h3>
                </div>
            }
            @*<div class="huni-category-card">
            <h3>Coffee</h3>
        </div>
        <div class="huni-category-card">
            <h3>Tea</h3>
        </div>
        <div class="huni-category-card">
            <h3>Cake</h3>
        </div>*@
        </div>
    </section>


 
        <section class="featured">
            <h2>Sản Phẩm Nổi Bật</h2>
            <div class="product-list">

                @foreach (var product in Model.Products)
                {
                    <div class="product-card">

                        <div class="product-image">
                            <img src="" alt="@product.ProductName" />
                        </div>

                        <div class="product-info">
                            <h3>@product.ProductName</h3>

                            <p class="price">
                                @String.Format("{0:N0} VNĐ", product.Price) // Định dạng giá tiền với dấu phẩy 
                            </p>

                            <a href="@Url.Action("Details", "Product", new { id = product.ProductID })"
                               class="detail-btn">
                                View Details
                            </a>
                        </div>
                    </div>
                }
            </div>
        </section>

       

</div>