@model HuniCafe.Models.Coupon

@{
    ViewBag.Title = "Thêm mã ưu đãi";
    Layout = "~/Views/LayOutPage/_AdminPage.cshtml";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="text-dark font-weight-bold"><i class="fas fa-plus-circle mr-2"></i>Thêm Mã Ưu Đãi Mới</h3>
        <a href="@Url.Action("CouponAdmin", "UuDai")" class="btn btn-secondary">
            <i class="fas fa-arrow-left mr-1"></i> Quay lại
        </a>
    </div>

    @using (Html.BeginForm("Create", "UuDai", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <div class="card shadow-sm p-4">
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <div class="form-row">
                <div class="form-group col-md-6">
                    <label class="font-weight-bold">Mã Giảm Giá (Code) <span class="text-danger">*</span></label>
                    @Html.EditorFor(model => model.Code, new { htmlAttributes = new { @class = "form-control", @required = "required" } })
                    @Html.ValidationMessageFor(model => model.Code, "", new { @class = "text-danger small" })
                </div>

                <div class="form-group col-md-6">
                    <label class="font-weight-bold">Loại Giảm Giá</label>
                    <select name="DiscountType" id="DiscountTypeSelect" class="form-control" onchange="updateDiscountUI()">
                        <option value="Percentage">Phần trăm (%)</option>
                        <option value="Fixed">Số tiền cố định (VNĐ)</option>
                    </select>
                </div>
            </div>

            <div class="form-row">
                <!-- Nhập giá trị giảm giá -->
                <div class="form-group col-md-6">
                    <label class="font-weight-bold" id="lblDiscountValue">Giá Trị Giảm <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <input type="number"
                               name="DiscountValue"
                               id="DiscountValueInput"
                               class="form-control"
                               step="1"
                               min="1"
                               required />
                        <div class="input-group-append">
                            <span class="input-group-text" id="discountUnit">%</span>
                        </div>
                    </div>
                    @Html.ValidationMessageFor(model => model.DiscountValue, "", new { @class = "text-danger small" })
                </div>

                <!-- Nhập đơn tối thiểu -->
                <div class="form-group col-md-6">
                    <label class="font-weight-bold">Giá Trị Đơn Hàng Tối Thiểu (VNĐ)</label>
                    <input type="number"
                           name="MinimumOrderValue"
                           class="form-control"
                           step="1000"
                           min="0"
                           value="0"/>
                    @Html.ValidationMessageFor(model => model.MinimumOrderValue, "", new { @class = "text-danger small" })
                </div>
            </div>

            <div class="form-row">
                <div class="form-group col-md-6">
                    <label class="font-weight-bold">Ngày Bắt Đầu <span class="text-danger">*</span></label>
                    <input type="date" name="StartDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                    @Html.ValidationMessageFor(model => model.StartDate, "", new { @class = "text-danger small" })
                </div>

                <div class="form-group col-md-6">
                    <label class="font-weight-bold">Ngày Kết Thúc <span class="text-danger">*</span></label>
                    <input type="date" name="EndDate" class="form-control" value="@DateTime.Now.AddDays(30).ToString("yyyy-MM-dd")" required />
                    @Html.ValidationMessageFor(model => model.EndDate, "", new { @class = "text-danger small" })
                </div>
            </div>

            <div class="form-row">
                <div class="form-group col-md-6">
                    <label class="font-weight-bold">Số Lượng Phát Hành <span class="text-danger">*</span></label>
                    <input type="number" name="Quantity" class="form-control" min="1" value="100" required />
                    @Html.ValidationMessageFor(model => model.Quantity, "", new { @class = "text-danger small" })
                </div>

                <div class="form-group col-md-6 align-self-center mt-3">
                    <div class="custom-control custom-switch">
                        <input type="checkbox" name="IsActive" class="custom-control-input" id="IsActive" value="true" checked />
                        <input type="hidden" name="IsActive" value="false" />
                        <label class="custom-control-label font-weight-bold text-dark" for="IsActive">Kích hoạt mã ngay</label>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="font-weight-bold">Mô Tả</label>
                @Html.TextAreaFor(model => model.Description, new { @class = "form-control", @rows = "3", @placeholder = "Nhập thông tin chi tiết về mã giảm giá..." })
                @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger small" })
            </div>

            <div class="mt-3 pt-3 border-top">
                <button type="submit" class="btn btn-success font-weight-bold"><i class="fas fa-save mr-1"></i> Lưu Mã Ưu Đãi</button>
                <a href="@Url.Action("CouponAdmin", "UuDai")" class="btn btn-secondary font-weight-bold ml-2">Hủy</a>
            </div>
        </div>
    }
</div>

<!-- JS TỰ ĐỘNG ĐỔI ĐƠN VỊ % HOẶC VNĐ -->
<script>
    function updateDiscountUI() {
        var type = document.getElementById("DiscountTypeSelect").value;
        var unit = document.getElementById("discountUnit");
        var input = document.getElementById("DiscountValueInput");

        if (type === "Percentage") {
            unit.innerText = "%";
            input.placeholder = "Nhập 10 cho 10%";
            input.setAttribute("max", "100");
        } else {
            unit.innerText = "VNĐ";
            input.placeholder = "Nhập 10000 cho 10.000 VNĐ";
            input.removeAttribute("max");
        }
    }

    document.addEventListener("DOMContentLoaded", function () {
        updateDiscountUI();
    });
</script>