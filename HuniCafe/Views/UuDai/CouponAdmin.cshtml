@model IEnumerable<HuniCafe.Models.Coupon>
@{
    ViewBag.Title = "CouponAdmin";
    Layout = "~/Views/LayOutPage/_AdminPage.cshtml";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="text-dark"><i class="fas fa-tags mr-2"></i>Quản Lý Mã Giảm Giá</h3>
        <a href="@Url.Action("Create")" class="btn btn-primary"><i class="fas fa-plus mr-1"></i> Thêm mã mới</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="close" data-dismiss="alert">&times;</button>
        </div>
    }

    <!-- Bộ Lọc & Tìm Kiếm -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            @using (Html.BeginForm("Index", "UuDai", FormMethod.Get, new { @class = "form-row align-items-center" }))
            {
                <div class="col-md-4 my-1">
                    <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control" placeholder="Tìm theo mã hoặc mô tả..." />
                </div>
                <div class="col-md-3 my-1">
                    <select name="statusFilter" class="form-control">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="active" @(ViewBag.StatusFilter == "active" ? "selected" : "")>Đang hoạt động</option>
                        <option value="inactive" @(ViewBag.StatusFilter == "inactive" ? "selected" : "")>Ngưng hoạt động / Hết lượt</option>
                        <option value="expired" @(ViewBag.StatusFilter == "expired" ? "selected" : "")>Đã hết hạn</option>
                        <option value="not_started" @(ViewBag.StatusFilter == "not_started" ? "selected" : "")>Chưa bắt đầu</option>
                    </select>
                </div>
                <div class="col-md-3 my-1">
                    <button type="submit" class="btn btn-info mr-2"><i class="fas fa-filter mr-1"></i> Lọc</button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">Đặt lại</a>
                </div>
            }
        </div>
    </div>

    <!-- Bảng Dữ Liệu -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="thead-dark">
                        <tr>
                            <th>Mã Voucher</th>
                            <th>Mô tả</th>
                            <th>Mức giảm</th>
                            <th>Đơn tối thiểu</th>
                            <th>Số lượng (Đã dùng/Tổng)</th>
                            <th>Thời hạn</th>
                            <th>Trạng thái</th>
                            <th class="text-center" style="width: 160px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                var now = DateTime.Now.Date;
                                bool isExpired = now > item.EndDate.Date;
                                bool isNotStarted = now < item.StartDate.Date;
                                bool isUsedUp = item.UsedQuantity >= item.Quantity;

                                <tr>
                                    <td><strong class="text-primary">@item.Code</strong></td>
                                    <td>@item.Description</td>
                                    <td>
                                        @(item.DiscountType == "Percentage" ? $"{item.DiscountValue}%" : $"{item.DiscountValue:N0}đ")
                                    </td>
                                    <td>@item.MinimumOrderValue.ToString("N0")đ</td>
                                    <td>@item.UsedQuantity / @item.Quantity</td>
                                    <td><small>@item.StartDate.ToString("dd/MM/yyyy") - @item.EndDate.ToString("dd/MM/yyyy")</small></td>
                                    <td>
                                        @if (!item.IsActive)
                                        {
                                            <span class="badge" style="background-color: #6c757d; color: #ffffff; padding: 6px 12px; font-size: 12px; font-weight: 600;">Tắt</span>
                                        }
                                        else if (isExpired)
                                        {
                                            <span class="badge" style="background-color: #dc3545; color: #ffffff; padding: 6px 12px; font-size: 12px; font-weight: 600;">Hết hạn</span>
                                        }
                                        else if (isNotStarted)
                                        {
                                            <span class="badge" style="background-color: #ffc107; color: #212529; padding: 6px 12px; font-size: 12px; font-weight: 600;">Chưa bắt đầu</span>
                                        }
                                        else if (isUsedUp)
                                        {
                                            <span class="badge" style="background-color: #343a40; color: #ffffff; padding: 6px 12px; font-size: 12px; font-weight: 600;">Hết lượt</span>
                                        }
                                        else
                                        {
                                            <span class="badge" style="background-color: #28a745; color: #ffffff; padding: 6px 12px; font-size: 12px; font-weight: 600;">Đang chạy</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a href="@Url.Action("Edit", new { id = item.ID })" class="btn btn-sm btn-warning font-weight-bold mr-1" title="Chỉnh sửa">
                                            <i class="fas fa-edit mr-1"></i>Sửa
                                        </a>
                                        <a href="@Url.Action("Delete", new { id = item.ID })" class="btn btn-sm btn-danger font-weight-bold" title="Xóa" onclick="return confirm('Bạn có chắc muốn xóa mã giảm giá này?');">
                                            <i class="fas fa-trash-alt mr-1"></i>Xóa
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">Không tìm thấy mã giảm giá nào.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>