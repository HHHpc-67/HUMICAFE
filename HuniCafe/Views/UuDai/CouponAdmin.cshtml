@model IEnumerable<HuniCafe.Models.Coupon>

@{
    ViewBag.Title = "Quản lý mã giảm giá";
    Layout = "~/Views/LayOutPage/_AdminPage.cshtml";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <a href="@Url.Action("Create")" class="btn btn-primary">+ Thêm Mã Mới</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <!-- Form Bộc Lọc & Tìm Kiếm -->
    <form method="get" action="@Url.Action("CouponAdmin")" class="row g-3 mb-4">
        <div class="col-md-4">
            <input type="text" name="searchString" class="form-control" placeholder="Tìm theo mã hoặc mô tả..." value="@ViewBag.SearchString" />
        </div>
        <div class="col-md-3">
            <select name="statusFilter" class="form-select">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="active" @(ViewBag.StatusFilter == "active" ? "selected" : "")>Đang hoạt động</option>
                <option value="inactive" @(ViewBag.StatusFilter == "inactive" ? "selected" : "")>Tắt / Ngưng</option>
                <option value="expired" @(ViewBag.StatusFilter == "expired" ? "selected" : "")>Đã hết hạn</option>
                <option value="not_started" @(ViewBag.StatusFilter == "not_started" ? "selected" : "")>Chưa diễn ra</option>
                <option value="used_up" @(ViewBag.StatusFilter == "used_up" ? "selected" : "")>Hết lượt dùng</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-secondary w-100">Lọc</button>
        </div>
    </form>

    <!-- Bảng Danh Sách Mã Giảm Giá -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Mã Code</th>
                        <th>Loại Giảm</th>
                        <th>Giá Trị</th>
                        <th>Đơn Tối Thiểu</th>
                        <th>Lượt Dùng</th>
                        <th>Thời Gian</th>
                        <th>Trạng Thái</th>
                        <th>Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var now = DateTime.Now.Date;
                            bool isExpired = now > item.EndDate;
                            bool isNotStarted = now < item.StartDate;
                            bool isUsedUp = item.UsedQuantity >= item.Quantity;

                            <tr>
                                <td><strong class="text-primary">@item.Code</strong></td>
                                <td>@(item.DiscountType == "Percentage" ? "Phần trăm" : "Cố định")</td>
                                <td>
                                    @(item.DiscountType == "Percentage" ? $"{item.DiscountValue}%" : $"{item.DiscountValue:N0} VNĐ")
                                </td>
                                <td>@item.MinimumOrderValue.ToString("N0") VNĐ</td>
                                <td>@item.UsedQuantity / @item.Quantity</td>
                                <td>
                                    <small>@item.StartDate.ToString("dd/MM/yyyy") - @item.EndDate.ToString("dd/MM/yyyy")</small>
                                </td>
                                <td>
                                    @if (!item.IsActive)
                                    {
                                        <span class="badge bg-secondary">Khóa</span>
                                    }
                                    else if (isExpired)
                                    {
                                        <span class="badge bg-danger">Hết hạn</span>
                                    }
                                    else if (isNotStarted)
                                    {
                                        <span class="badge bg-warning text-dark">Chưa chạy</span>
                                    }
                                    else if (isUsedUp)
                                    {
                                        <span class="badge bg-dark">Hết lượt</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Hoạt động</span>
                                    }
                                </td>
                                <td>
                                    <a href="@Url.Action("Edit", new { id = item.ID })" class="btn btn-sm btn-outline-warning">Sửa</a>
                                    <a href="@Url.Action("Delete", new { id = item.ID })" class="btn btn-sm btn-outline-danger">Xóa</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">Không tìm thấy mã giảm giá nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>