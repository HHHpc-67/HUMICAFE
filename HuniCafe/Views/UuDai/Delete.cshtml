@model HuniCafe.Models.Coupon

@{
    ViewBag.Title = "Delete";
    Layout = "~/Views/LayOutPage/_AdminPage.cshtml";
}

<div class="container-fluid py-3">
    <h2 class="text-danger font-weight-bold mb-3">Xác Nhận Xóa Mã Ưu Đãi</h2>
    <p class="text-muted">Bạn có chắc chắn muốn xóa mã ưu đãi này không? Thao tác này không thể hoàn tác.</p>

    <div class="card border-danger shadow p-4 mb-4">
        <dl class="row mb-0">
            <dt class="col-sm-3 font-weight-bold">Mã Code:</dt>
            <dd class="col-sm-9 text-danger font-weight-bold">@Model.Code</dd>

            <dt class="col-sm-3 font-weight-bold">Mô Tả:</dt>
            <dd class="col-sm-9">@Model.Description</dd>

            <dt class="col-sm-3 font-weight-bold">Giá Trị Giảm:</dt>
            <dd class="col-sm-9">@(Model.DiscountType == "Percentage" ? $"{Model.DiscountValue}%" : $"{Model.DiscountValue:N0} VNĐ")</dd>

            <dt class="col-sm-3 font-weight-bold">Thời Gian:</dt>
            <dd class="col-sm-9">@Model.StartDate.ToString("dd/MM/yyyy") - @Model.EndDate.ToString("dd/MM/yyyy")</dd>
        </dl>
    </div>

    @using (Html.BeginForm("Delete", "UuDai", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.ID)
        <button type="submit" class="btn btn-danger"><i class="fas fa-trash mr-1"></i> Xác Nhận Xóa</button>
        <a href="@Url.Action("CouponAdmin", "UuDai")" class="btn btn-secondary ml-2">Hủy Bỏ</a>
    }
</div>

