@model IEnumerable<HuniCafe.Models.Users>

@{
    ViewBag.Title = "Quản lý người dùng";
    Layout = "~/Views/LayOutPage/_AdminPage.cshtml";
}

<div class="container-fluid my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <a href="@Url.Action("Register", "Users")" class="btn btn-success btn-sm">
            + Thêm tài khoản
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0 text-center">
                    <thead class="table-dark">
                        <tr>
                            <th>Mã ID</th>
                            <th>Tên đăng nhập</th>
                            <th>Họ và tên</th>
                            <th>Email</th>
                            <th>Vai trò</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count() > 0)
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td><strong>#@item.UserID</strong></td>
                                    <td>@item.Username</td>
                                    <td>@(string.IsNullOrEmpty(item.FullName) ? "Chưa cập nhật" : item.FullName)</td>
                                    <td>@item.Email</td>
                                    <td>
                                        @if (item.Role == "Admin")
                                        {
                                            <span class="badge bg-danger">Admin</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary">Customer</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="@Url.Action("Delete", "Users", new { id = item.UserID })" class="btn btn-sm btn-danger" onclick="return confirm('Bạn có chắc muốn xóa tài khoản này?');">Xóa</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-muted py-3">Chưa có người dùng nào.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

